{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.2",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://s.nia.gov.cn/*",
        "https://eservices.ica.gov.sg/*",
        "https://imigresen-online.imi.gov.my/*",
        "https://tdac.immigration.go.th/*",
        "https://prearrival.immigration.gov.vn/*",
        "https://allindonesia.imigrasi.go.id/*",
        "https://twac.immigration.gov.tw/*",
        "https://indianvisaonline.gov.in/*",
        "https://imuga.immigration.gov.mv/*",
        "https://www.e-arrivalcard.go.kr/*",
                "https://etravel.gov.ph/*",
        "https://www.etravel.gov.ph/*",
        "https://www.vjw.digital.go.jp/*",
        "https://vjw.digital.go.jp/*",
        "https://www.imm.gov.bn/*",
        "https://imm.gov.bn/*",
        "https://www.travellerdeclaration.govt.nz/*",
        "https://travellerdeclaration.govt.nz/*",
        "https://eticket.migracion.gob.do/*",
        "https://www.eticket.migracion.gob.do/*",
        "https://enterjamaica.gov.jm/*",
        "https://www.enterjamaica.gov.jm/*",
        "https://edcard.dominica.gov.dm/*",
        "https://www.edcard.dominica.gov.dm/*",
        "https://travel.gov.tt/*",
        "https://www.travel.gov.tt/*",
        "https://arrival.gov.kh/*"
      ],
      "js": [
        "i18n.js",
        "i18n-packs.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.com.hk/search*",
        "https://www.google.com.sg/search*",
        "https://www.google.com.tw/search*",
        "https://www.google.com.my/search*",
        "https://www.google.com.vn/search*",
        "https://www.google.com.au/search*",
        "https://www.google.com.ph/search*",
        "https://www.google.com.kh/search*",
        "https://www.google.co.jp/search*",
        "https://www.google.co.kr/search*",
        "https://www.google.co.th/search*",
        "https://www.google.co.id/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.google.es/search*",
        "https://www.google.it/search*",
        "https://www.google.pl/search*",
        "https://www.google.ru/search*",
        "https://www.google.com.tr/search*",
        "https://www.google.com.ua/search*",
        "https://www.google.nl/search*",
        "https://www.google.pt/search*",
        "https://www.google.com.br/search*",
        "https://www.google.cz/search*",
        "https://www.google.hu/search*",
        "https://www.google.ro/search*",
        "https://www.google.gr/search*",
        "https://www.google.co.il/search*",
        "https://www.google.com.sa/search*",
        "https://www.google.ae/search*",
        "https://www.google.com.eg/search*",
        "https://www.google.co.nz/search*",
        "https://www.google.com.jm/search*",
        "https://www.google.com.do/search*",
        "https://www.google.tt/search*"
      ],
      "js": ["i18n.js", "i18n-packs.js", "search-hint.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/countries/*.json",
        "data/nationality.json",
        "content.css",
        "icons/*.svg"
      ],
      "matches": [
        "https://s.nia.gov.cn/*",
        "https://eservices.ica.gov.sg/*",
        "https://imigresen-online.imi.gov.my/*",
        "https://tdac.immigration.go.th/*",
        "https://prearrival.immigration.gov.vn/*",
        "https://allindonesia.imigrasi.go.id/*",
        "https://twac.immigration.gov.tw/*",
        "https://indianvisaonline.gov.in/*",
        "https://imuga.immigration.gov.mv/*",
        "https://www.e-arrivalcard.go.kr/*",
                "https://etravel.gov.ph/*",
        "https://www.etravel.gov.ph/*",
        "https://www.vjw.digital.go.jp/*",
        "https://vjw.digital.go.jp/*",
        "https://www.imm.gov.bn/*",
        "https://imm.gov.bn/*",
        "https://www.travellerdeclaration.govt.nz/*",
        "https://travellerdeclaration.govt.nz/*",
        "https://eticket.migracion.gob.do/*",
        "https://www.eticket.migracion.gob.do/*",
        "https://enterjamaica.gov.jm/*",
        "https://www.enterjamaica.gov.jm/*",
        "https://edcard.dominica.gov.dm/*",
        "https://www.edcard.dominica.gov.dm/*",
        "https://travel.gov.tt/*",
        "https://www.travel.gov.tt/*",
        "https://arrival.gov.kh/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}